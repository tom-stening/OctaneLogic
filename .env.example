# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Database ---
DATABASE_URL=postgresql+asyncpg://octane:octane@localhost:5432/octanelogic
POSTGRES_PASSWORD=change_me_strong_password

# Field-level encryption key for coordinate storage (32 bytes, hex or plain)
DB_ENCRYPTION_KEY=changeme-32-byte-encryption-key!

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- FuelCheck NSW API ---
# Register at https://api.nsw.gov.au/ — free for personal use
FUELCHECK_API_KEY=

# --- Open Charge Map ---
# Register at https://openchargemap.org/site/develop/api
OCM_API_KEY=

# --- AEMO / NEM region ---
# NSW1 | QLD1 | SA1 | TAS1 | VIC1
NEM_REGION=NSW1

# --- App ---
DEBUG=false

# User's perceived time value (AUD/hour) for Detour Delta calculations
TIME_VALUE_PER_HOUR_AUD=25.0
